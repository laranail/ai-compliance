# Normalize line endings on checkout/commit.
* text=auto eol=lf

# Keep the Composer dist lean — exclude dev-only paths from package archives
# (`composer require` / `dist` downloads). Source, README, LICENSE, CHANGELOG
# and composer.json stay in the distributed package.
/tests                 export-ignore
/docs                  export-ignore
/.github               export-ignore
/.claude               export-ignore
/phpunit.xml           export-ignore
/phpstan.neon          export-ignore
/pint.json             export-ignore
/rector.php            export-ignore
/.editorconfig         export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
