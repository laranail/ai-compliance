includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - vendor
    treatPhpDocTypesAsCertain: false
    # the livewire view-string ignore below only fires on a cold skeleton
    # (ci); locally a warm view cache makes the namespace resolvable and the
    # error disappears, so an unmatched ignore must not itself fail the run
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # larastan validates a view-string literal against a skeleton app that never
        # boots this package's provider, so a namespace registered at RUNTIME is
        # invisible to it and every `view()` / `View::make()` call reads as an error.
        # The views exist; the suite renders them. Broad on purpose -- the narrow
        # forms missed `static method`, `Contracts\View\Factory` and the helper,
        # each of which had to be discovered from a red run.
        - '#expects view-string, string given#'
        # larastan validates view-string literals against a skeleton app that
        # never boots this package's provider, so the ai-compliance:: view
        # namespace is invisible to it. every one of these views is rendered
        # by the pest suite, which is the real existence check.
        -
            identifier: argument.type
            message: '#Parameter \#1 \$view of function view expects view-string#'
            path: src/Livewire/*
        # The same blindness through the view factory rather than the helper.
        # IslandRenderer and ComplianceReport call $this->views->make(), which is
        # Illuminate\View\Factory::make() — a different signature from view(), so
        # the pattern above never matched it and the error surfaced on every run.
        -
            identifier: argument.type
            message: '#Parameter \#1 \$view of method Illuminate\\(Contracts\\View\\|View\\)Factory::make\(\) expects view-string#'
            paths:
                - src/View/*
                - src/Reports/*
